@model NyayaDesk.Models.ViewModels.Subscription.SubscriptionPageVM
@{ ViewBag.Title = "Plans & Subscription"; }
<style>
.sub-page{font-family:Inter,"Segoe UI",sans-serif;background:#f3f7fb;min-height:100vh;padding:42px}.sub-shell{max-width:1180px;margin:auto}.sub-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:30px}.sub-head h1{font-size:34px;color:#0d1830;margin:5px 0}.sub-kicker{font-size:12px;font-weight:800;letter-spacing:.14em;color:#0d9b8d}.current-sub{background:#173b64;color:white;border-radius:18px;padding:25px 28px;display:grid;grid-template-columns:1fr auto;gap:20px;margin-bottom:30px;box-shadow:0 14px 35px rgba(16,49,84,.16)}.current-sub h2{margin:5px 0}.sub-status{display:inline-block;background:#d9f5eb;color:#087a5f;padding:7px 12px;border-radius:999px;font-weight:800;font-size:12px}.sub-expiry{text-align:right}.sub-expiry strong{display:block;font-size:28px}.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.plan{background:white;border:1px solid #dfe7ef;border-radius:18px;padding:26px;position:relative;box-shadow:0 8px 26px rgba(18,48,75,.06)}.plan.popular{border:2px solid #0d9b8d;transform:translateY(-6px)}.popular-tag{position:absolute;right:18px;top:17px;background:#def5f1;color:#087a70;padding:5px 9px;border-radius:999px;font-size:11px;font-weight:800}.plan h3{font-size:22px;color:#10233d;margin:0 0 7px}.plan>p{color:#687a90;min-height:48px}.price{font-size:34px;font-weight:850;color:#10233d;margin:20px 0}.price small{font-size:13px;color:#718197}.features{list-style:none;padding:0;margin:22px 0}.features li{padding:9px 0;border-bottom:1px solid #edf1f5;color:#34465b}.features .off{color:#9ba7b4}.plan button{width:100%;height:48px;border:0;border-radius:10px;background:#0d9b8d;color:white;font-weight:800}.plan button[disabled]{background:#dce4ea;color:#768493}.sub-note{margin-top:24px;color:#6c7c8f;font-size:13px}@media(max-width:850px){.plans{grid-template-columns:1fr}.plan.popular{transform:none}.sub-page{padding:24px 16px}.current-sub{grid-template-columns:1fr}.sub-expiry{text-align:left}}
</style>
<main class="sub-page"><div class="sub-shell">
<header class="sub-head"><div><span class="sub-kicker">NYAYADesk SAAS</span><h1>Plans & Subscription</h1><p>Manage your legal workspace plan, limits and billing cycle.</p></div><a href="@Url.Action("Index","Dashboard")">Back to dashboard</a></header>
@if(Model.Current != null){<section class="current-sub"><div><span class="sub-status">@Model.Current.Status</span><h2>@Model.Current.TenantName</h2><div>@Model.Current.PlanName plan · @Model.Current.TenantCode</div></div><div class="sub-expiry"><span>Days remaining</span><strong>@Model.Current.DaysRemaining</strong><small>Renews/ends @Model.Current.PeriodEnd.ToString("dd MMM yyyy")</small></div></section>}
<section class="plans">@foreach(var plan in Model.Plans){bool current=Model.Current != null && Model.Current.PlanCode == plan.Code;<article class="plan @(plan.IsPopular ? "popular" : "")">@if(plan.IsPopular){<span class="popular-tag">MOST POPULAR</span>}<h3>@plan.Name</h3><p>@plan.Description</p><div class="price">₹@plan.MonthlyPrice.ToString("N0") <small>/ month + GST</small></div><ul class="features">@foreach(var f in plan.Features){<li class="@(f.Enabled ? "" : "off")">@(f.Enabled ? "✓" : "—") @f.Name @(f.Limit.HasValue ? "· " + f.Limit.Value : "")</li>}</ul><button disabled="disabled">@(current ? "Current plan" : "Choose plan")</button></article>}</section>
<p class="sub-note">Payment gateway activation billing phase mein signed webhook verification ke saath connect hoga. Isliye plan purchase buttons abhi intentionally disabled hain.</p>
</div></main>
